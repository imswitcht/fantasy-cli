/* Sleeper-inspired dark palette: near-black ground, slate card rows,
   colored position badges. Approximate, not pixel-matched. */

Screen {
    background: #0e1015;
    color: #d7dce2;
}

Header {
    background: #14171d;
    color: #f2f4f7;
}

Footer {
    background: #14171d;
}

TabbedContent Tab {
    color: #8b93a1;
}

TabbedContent Tab.-active {
    color: #f2f4f7;
    background: #21252d;
    text-style: bold;
}

.summary {
    padding: 1 2 0 2;
}

#starters, #bench-rows {
    /* Without an explicit width, these Vertical containers don't reliably
       stretch to the full RosterView width the way a plain Horizontal
       (.column-header) does -- verified live (100-wide RosterView, but
       #starters measuring 97) -- so PlayerRow's fr-sized columns end up
       computed against a smaller base than ColumnHeader's, offsetting
       every column after the first flexible one. */
    width: 100%;
}

.section-label {
    color: #8b93a1;
    text-style: bold;
    margin: 1 1 0 2;
}

#controls {
    height: auto;
    padding: 0 2;
    align: left middle;
}

#controls Label {
    margin: 0 1 0 0;
    padding-top: 1;
}

#controls Switch {
    margin-top: 0;
}

.player-row {
    /* The only source of left/right inset for a row -- #starters/#bench-rows
       deliberately have none, so a row lines up with .column-header (which
       has exactly this same padding). Double-padding both levels is what
       threw the header out of alignment with the data columns. */
    height: 1;
    background: #181b21;
    padding: 0 1;
    align: left middle;
}

.player-row.writable:hover {
    background: #1c2027;
}

.player-row.selected {
    background: #2a2450;
}

.badge {
    width: 5;
    content-align: center middle;
    text-style: bold;
    color: #0e1015;
    margin-right: 1;
}

.pos-qb  { background: #7c5cff; }
.pos-rb  { background: #2fbf71; }
.pos-wr  { background: #3ea6ff; }
.pos-te  { background: #ff8a3d; }
.pos-k   { background: #9aa4b2; }
.pos-def { background: #5b6b8c; }

.player-name {
    /* Flexes with the terminal width -- the two fixed-format-number/badge
       columns either side don't benefit from extra space, so Name and Game
       are the ones that absorb whatever room a wider window has to give,
       and are the first to give it back on a narrower one. */
    width: 2fr;
    min-width: 12;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #f2f4f7;
}

.clickable-name:hover {
    text-style: underline;
    color: #a996ff;
}

.player-team {
    width: 5;
    color: #8b93a1;
}

.player-opp {
    width: 6;
    color: #8b93a1;
}

.player-game {
    /* text-overflow is the safety net: a wrapped 2nd line inside a height:1
       row is the same class of bug as an unbudgeted border -- the row's
       fixed height can't grow to fit it, so overflow must be clipped rather
       than wrapped. Real pregame strings ("9/13 - 1:00 PM EDT") run long,
       and live/final rows prepend a score ("13-10 2:51 - 3rd"). Flexes with
       Name -- see the comment there. */
    width: 1fr;
    min-width: 12;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #8b93a1;
}

.player-proj {
    width: 6;
    content-align: right middle;
    color: #d7dce2;
}

.player-actual {
    width: 6;
    content-align: right middle;
    color: #d7dce2;
}

.player-avail {
    /* Widest remaining un-abbreviated status is SUSPENDED (9 chars) --
       Q/O cover QUESTIONABLE/OUT now, so this no longer needs 12. */
    width: 10;
    content-align: right middle;
}

.move-btn {
    width: 4;
    min-width: 4;
    height: 1;
    margin-left: 1;
    padding: 0;
    border: none;
    background: #2a2f3a;
    color: #f2f4f7;
}

.move-btn:hover {
    background: #7c5cff;
}

.move-btn-spacer {
    width: 5;
}

.column-header {
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

.header-cell {
    color: #5b6270;
    text-style: bold;
}

SwapConfirmScreen {
    align: center middle;
}

#swap-dialog {
    width: 60;
    height: auto;
    background: #14171d;
    border: round #7c5cff;
    padding: 1 2;
}

#swap-dialog .swap-line {
    padding: 0 0 1 0;
}

#swap-buttons {
    height: auto;
    align: right middle;
    padding-top: 1;
}

#swap-buttons Button {
    margin-left: 1;
}

PlayerInfoScreen {
    align: center middle;
}

#info-dialog {
    width: 70;
    height: auto;
    max-height: 30;
    overflow-y: auto;
    background: #14171d;
    border: round #7c5cff;
    padding: 1 2;
}

#info-dialog .info-line {
    padding: 0 0 1 0;
}

#info-extra {
    height: auto;
}

.news-item {
    height: auto;
    padding: 0 0 1 0;
    color: #8b93a1;
}

.clickable-news:hover {
    color: #a996ff;
    text-style: underline;
}

#info-buttons {
    height: auto;
    align: right middle;
    padding-top: 1;
}

#week-cycler {
    height: 3;
    padding: 1 2 0 2;
    align: left middle;
}

#week-cycler Button {
    min-width: 3;
    height: 1;
    border: none;
    padding: 0 1;
    background: #2a2f3a;
}

#week-cycler Button:hover {
    background: #7c5cff;
}

#week-label {
    width: 10;
    text-align: center;
    text-style: bold;
    color: #f2f4f7;
}

#matchup-select {
    margin: 1 2;
}

#matchup-columns {
    height: auto;
    padding: 0 2;
}

.matchup-column {
    width: 1fr;
    padding: 0 1;
}

.matchup-team-label {
    padding: 0 0 1 0;
    color: #8b93a1;
}

.matchup-player-row {
    height: 1;
    background: #181b21;
    padding: 0 1;
    align: left middle;
}

.matchup-player-name {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #f2f4f7;
}

.matchup-player-avail {
    width: 3;
    content-align: right middle;
}

.matchup-player-pts {
    width: 10;
    content-align: right middle;
    color: #d7dce2;
}

.matchup-player-pts-proj {
    /* Projected only, no real score yet -- same secondary-text gray used
       for Team/Opp/Game elsewhere, not the brighter color a real score gets. */
    color: #8b93a1;
}

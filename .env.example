# Copy to .env . This file is gitignored -- never commit it.

# ESPN: browser cookies. See `ff auth espn`.
ESPN_S2=
ESPN_SWID={}

# Sleeper: just your username, no secret involved.
SLEEPER_USERNAME=

# Yahoo: path to the OAuth token file. See `ff auth yahoo`.
YAHOO_TOKEN_PATH=secrets/yahoo_token.json
